// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "base_keymap": "VSCode",
  "buffer_line_height": "comfortable",
  "ui_font_family": ".ZedSans",
  "buffer_font_family": ".ZedMono",
  "agent_buffer_font_size": 12.0,
  "enable_language_server": true,
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "tabs": {
    "file_icons": false,
    "git_status": true,
  },
  "debugger": {
    "button": true,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "button": true,
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true,
  },
  "show_edit_predictions": true,
  "title_bar": {
    "show_menus": false,
    "show_branch_name": true,
    "show_branch_icon": true,
    "show_sign_in": true,
    "show_user_picture": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
  },
  "tab_bar": {
    "show": true,
  },
  "autosave": "off",
  "helix_mode": false,
  "agent_ui_font_size": 15.0,
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "terminal": {
    "default_height": 300.0,
    "button": false,
    "font_family": "MesloLGS Nerd Font",
    "font_size": 11.0,
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
    },
    "model_parameters": [],
  },
  "icon_theme": "Material Icon Theme",
  "project_panel": {
    "button": true,
    "folder_icons": true,
    "file_icons": true,
    "dock": "left",
  },

  // ── Vim ──────────────────────────────────────────
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": false,
    "use_system_clipboard": "on_yank",
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 250,
  },

  // ── Cursor & Scroll ──────────────────────────────
  "cursor_blink": false,
  "vertical_scroll_margin": 8,
  "scrollbar": {
    "show": "never",
  },

  // ── Ex Command Aliases (catch typos) ─────────────
  "command_aliases": {
    "W": "w",
    "Q": "q",
    "Wq": "wq",
    "WQ": "wq",
    "Qa": "qa",
    "QA": "qa",
    "Wa": "wa",
    "WA": "wa",
  },

  // ── Git ──────────────────────────────────────────
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },

  // ── Code Intelligence ────────────────────────────
  "inlay_hints": {
    "enabled": true,
  },
  "indent_guides": {
    "enabled": true,
  },

  "theme": {
    "mode": "system",
    "light": "Catppuccin Macchiato",
    "dark": "Noctis",
  },
  "outline_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },

  // ── Language Overrides ─────────────────────────────
  "languages": {
    "Go": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "goimports",
          "arguments": [],
        },
      },
      "tab_size": 4,
      "hard_tabs": true,
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
  },
}
