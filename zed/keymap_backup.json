[
  // ==================================================
  // GLOBAL
  // ==================================================
  {
    "context": "",
    "bindings": {
      "alt-d": "workspace::ToggleBottomDock",
    },
  },

  // ==================================================
  // EDITOR — NORMAL MODE (LazyVim leader)
  // ==================================================
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // ----- Files / Find -----
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space b b": "tab_switcher::Toggle",
      "space b d": "pane::CloseActiveItem",

      // ----- Search / Grep -----
      "space /": "pane::DeploySearch",
      "space s g": "pane::DeploySearch",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",
      "space s b": "buffer_search::Deploy",

      // ----- Panels -----
      "space e": "project_panel::ToggleFocus",
      "space g g": "git_panel::ToggleFocus",
      "space t t": "terminal_panel::ToggleFocus",
      "space d d": "debug_panel::ToggleFocus",
      "space x x": "diagnostics::Deploy",
      "space a a": "agent::ToggleFocus",

      // ----- LSP / Code -----
      "space l r": "editor::RestartLanguageServer",
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "shift-k": "editor::Hover",

      // ----- Diagnostics -----
      "space x j": "editor::GoToDiagnostic",
      "space x k": "editor::GoToPrevDiagnostic",

      // ----- Debug -----
      "space d b": "editor::ToggleBreakpoint",

      // ----- Save / Quit -----
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",

      // ----- Toggle UI -----
      "space u w": "editor::ToggleSoftWrap",
      "space u h": "editor::ToggleInlayHints",

      // ----- Tab movement -----
      "[ [": "pane::SwapItemLeft",
      "] ]": "pane::SwapItemRight",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
    },
  },

  // ==================================================
  // SNEAK (two-char search, like leap.nvim)
  // ==================================================
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },

  // ==================================================
  // VISUAL MODE ENHANCEMENTS
  // ==================================================
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
    },
  },

  // ==================================================
  // WINDOW / PANE MANAGEMENT (Ctrl-w like Neovim)
  // ==================================================
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-w v": "pane::SplitRight",
      "ctrl-w s": "pane::SplitDown",

      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",

      "ctrl-w q": "pane::CloseActiveItem",
    },
  },

  // ==================================================
  // TMUX-STYLE PANE NAVIGATION
  // ==================================================
  {
    "context": "Pane || ProjectPanel || Terminal || Editor && vim_mode == normal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },

  // ==================================================
  // COMPLETIONS / CODE ACTIONS
  // ==================================================
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },

  // ==================================================
  // TAB SWITCHER (Vim navigation)
  // ==================================================
  {
    "context": "TabSwitcher",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "down"],
      "k": ["workspace::SendKeystrokes", "up"],
      "d": "tab_switcher::CloseSelectedItem",
      "escape": "tab_switcher::Toggle",
    },
  },

  // ==================================================
  // DEBUGGER (LazyVim mnemonics)
  // ==================================================
  {
    "context": "DebugPanel || Editor && vim_mode == normal",
    "bindings": {
      "space d g": "debugger::Start",
      "space d c": "debugger::Continue",
      "space d n": "debugger::StepOver",
      "space d i": "debugger::StepInto",
      "space d o": "debugger::StepOut",
      "space d r": "debugger::Restart",
      "space d s": "debugger::Stop",
    },
  },

  // ==================================================
  // TERMINAL
  // ==================================================
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-n": "workspace::NewTerminal",
    },
  },
  {
    "context": "Terminal && !vi_mode",
    "bindings": {
      "escape": "terminal_panel::ToggleFocus",
      "shift-space": "terminal::ToggleViMode",
    },
  },
  {
    "context": "Terminal && vi_mode",
    "bindings": {
      "escape": "terminal::ToggleViMode",
    },
  },

  // ==================================================
  // SPACE/ESC CLOSES PANELS
  // ==================================================
  {
    "context": "ProjectPanel",
    "bindings": {
      "space": "project_panel::ToggleFocus",
      "escape": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "space": "git_panel::ToggleFocus",
      "escape": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "DebugPanel",
    "bindings": {
      "space": "debug_panel::ToggleFocus",
      "escape": "debug_panel::ToggleFocus",
    },
  },

  // ==================================================
  // INSERT MODE ESCAPE
  // ==================================================
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": ["workspace::SendKeystrokes", "escape"],
    },
  },
]
